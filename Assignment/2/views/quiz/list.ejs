<h2>All Quizzes</h2>
<a href="/quizzes/create" class="btn btn-success mb-3">Create Quiz</a>
<table class="table table-bordered">
  <thead>
    <tr>
      <th>Title</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% quizzes.forEach(quiz => { %>
    <tr>
      <td><%= quiz.title %></td>
      <td>
        <a href="/quizzes/<%= quiz._id %>" class="btn btn-primary btn-sm"
          >View</a
        >
        <a href="/quizzes/<%= quiz._id %>/edit" class="btn btn-warning btn-sm"
          >Edit</a
        >
        <form
          action="/quizzes/<%= quiz._id %>?_method=DELETE"
          method="POST"
          style="display: inline"
        >
          <button class="btn btn-danger btn-sm">Delete</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

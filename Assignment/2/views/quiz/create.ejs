<h2>Create Quiz</h2>
<form method="POST" action="/quizzes">
  <div class="mb-3">
    <label for="title" class="form-label">Quiz Title</label>
    <input type="text" class="form-control" id="title" name="title" required />
  </div>
  <button type="submit" class="btn btn-success">Create</button>
</form>

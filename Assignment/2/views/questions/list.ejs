<h2>All Questions</h2>
<a href="/questions/create" class="btn btn-success mb-3">Create Question</a>
<table class="table table-bordered">
  <thead>
    <tr>
      <th>Text</th>
      <th>Quiz</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% questions.forEach(question => { %>
    <tr>
      <td><%= question.text %></td>
      <td><%= question.quiz?.title || "Unassigned" %></td>
      <td>
        <a href="/questions/<%= question._id %>" class="btn btn-primary btn-sm"
          >View</a
        >
        <a
          href="/questions/<%= question._id %>/edit"
          class="btn btn-warning btn-sm"
          >Edit</a
        >
        <form
          action="/questions/<%= question._id %>?_method=DELETE"
          method="POST"
          style="display: inline"
        >
          <button class="btn btn-danger btn-sm">Delete</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
